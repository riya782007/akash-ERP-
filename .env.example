# Set environment variables in your shell; this file is documentation, not auto-loaded.
ERP_ADMIN_PASSWORD=replace-with-a-long-unique-password
PORT=4310
HOST=127.0.0.1
ERP_DB=data/mehers.sqlite
# Set only behind a trusted HTTPS reverse proxy:
ERP_SECURE_COOKIE=1

# Vercel frontend only (not needed on backend):
ERP_BACKEND_ORIGIN=https://your-durable-backend.example.com
# Backend: exact Vercel production origin, no trailing slash:
ERP_PUBLIC_ORIGIN=https://your-production-domain.vercel.app
# Backend only; optional AI. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_DAILY_REQUEST_LIMIT=25
