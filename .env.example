# Mehers ERP environment variables. Set these in Vercel → Project → Settings → Environment Variables
# (Production). This file is documentation only; it is not loaded automatically.

# ── Required ────────────────────────────────────────────────────────────────
# Supabase → your project → Connect → "Transaction pooler" connection string (port 6543).
# Replace [YOUR-PASSWORD] with the database password; URL-encode special characters (@ → %40, # → %23).
DATABASE_URL=postgresql://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# Password for the first login (username: owner). Used only once, when the database is empty.
# At least 12 characters. Changing it later does NOT change the owner's password.
ERP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# ── Optional: AI assist ─────────────────────────────────────────────────────
# OpenAI project API key (platform.openai.com → API keys). Server-side only; never exposed to the browser.
OPENAI_API_KEY=
# Lowest-cost OpenAI model ($0.10 / $0.50 per 1M input/output tokens). Default if unset.
OPENAI_MODEL=gpt-6-luna
# Store-wide cap on AI requests per day (1–5000). ~100 requests ≈ a few rupees.
AI_DAILY_REQUEST_LIMIT=100

# ── Local development only (not needed on Vercel) ───────────────────────────
# Without DATABASE_URL, `npm start` uses an embedded Postgres in ./data/pglite.
# PORT=4310
# HOST=127.0.0.1
# ERP_SECURE_COOKIE=1    # set when serving over HTTPS outside Vercel (Vercel sets Secure automatically)
